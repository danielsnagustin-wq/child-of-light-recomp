<?xml version="1.0" encoding="utf-8"?>
<!-- Boton principal (JUGAR): degradado turquesa -> azul hielo, esquinas
     redondeadas, ripple blanco suave al pulsar. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#75D6CE"
                android:endColor="#8CCBEB" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
