         println("\t{0}.u64 = {1}.u32 == 0 ? 32 : __builtin_clz({1}.u32);", r(insn.operands[0]), r(insn.operands[1]));
         break;
 
+    case PPC_INST_CROR:
+        println("\t{}.{} = {}.{} | {}.{};", cr(insn.operands[0] / 4), CR_BIT_NAMES[insn.operands[0] % 4], cr(insn.operands[1] / 4), CR_BIT_NAMES[insn.operands[1] % 4], cr(insn.operands[2] / 4), CR_BIT_NAMES[insn.operands[2] % 4]);
+        break;
+
+    case PPC_INST_CRORC:
+        println("\t{}.{} = {}.{} | !{}.{};", cr(insn.operands[0] / 4), CR_BIT_NAMES[insn.operands[0] % 4], cr(insn.operands[1] / 4), CR_BIT_NAMES[insn.operands[1] % 4], cr(insn.operands[2] / 4), CR_BIT_NAMES[insn.operands[2] % 4]);
+        break;
+
     case PPC_INST_DB16CYC:
         // no op
         break;
@@ -1165,5 +1165,15 @@
