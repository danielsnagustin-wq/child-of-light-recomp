From: Aurora <aurora@child-of-light-recomp.local>
Date: Fri, 13 Nov 2026 20:20:00 -0600
Subject: [PATCH 21] ppc_context.h: keep PPCContext layout complete and
 byte-identical to the SDK runtime struct

Two layout fixes, both required before flipping any *_as_local option
(hunt-recomp P0-3):

1. The SDK runtime's ::PPCContext (rex/ppc/context.h) is always complete,
   but this template guards each register group with
   #ifndef PPC_CONFIG_*_AS_LOCAL. With register-as-local on, the generated
   struct loses r0/r2/r11/r12, r14-r31, ctr, xer, reserved, cr0-7, f0,
   f14-f31, v14-v31, v32-v63 and v64-v127, so its layout diverges from the
   runtime struct while both sides operate on the SAME object
   (ThreadState::context_storage_). The runtime's SaveNonVolatiles /
   SaveContext / LoadContext and the dispatcher read r14-r31, f14-f31,
   v14-v31, v64-v127, cr2-cr4, lr and msr by name; generated code still
   touches ctx.lr / ctx.msr / ctx.fpscr / ctx.f1-f13 / ctx.v0-v13. A pruned
   struct would shift all of those offsets (e.g. lr 256 -> ~112) and
   silently corrupt guest state. The *_as_local options still take effect
   in codegen (registers become C++ locals); the fields simply stay
   reserved so the layout is identical on both sides. localize_fix_col.py
   also demotes live-in registers back to ctx.<reg>, which would not
   compile if the fields did not exist. This also future-proofs phase 2
   (skip_lr/skip_msr): the runtime reads ctx.lr directly (SaveContext,
   dispatcher, xmemory log), so lr/msr must stay in the struct too.

2. Add the SDK's two extra fields between fpscr and f0 (vscr_sat,
   last_indirect_target). Without them every f*/v* register sits 8 bytes
   off across the guest/host boundary. This is the Fase 2 hand-fix from
   the Android copy of the generated header, now in the template so a
   re-recomp cannot lose it (the desktop copy recomp/ppc/ppc_context.h
   still lacks them today: measured GEN f0=328 vs RT f0=336).

Verified: with all config options false, offsetof() of every field of the
generated struct equals the runtime struct's (sizeof 2688 both).

diff --git a/XenonUtils/ppc_context.h b/XenonUtils/ppc_context.h
index 31a86cd..31a4d0f 100644
--- a/XenonUtils/ppc_context.h
+++ b/XenonUtils/ppc_context.h
@@ -303,14 +303,24 @@ struct PPCFPSCRRegister
 
 struct alignas(0x40) PPCContext
 {
+    // CoL (patch 0021): every field here is UNCONDITIONAL. Upstream guards
+    // each group with #ifndef PPC_CONFIG_*_AS_LOCAL, so with register-as-local
+    // the generated struct loses fields and its layout diverges from the SDK
+    // runtime's ::PPCContext (rex/ppc/context.h), which is always complete.
+    // Both sides operate on the SAME object (ThreadState::context_storage_):
+    // the runtime's SaveNonVolatiles / SaveContext / LoadContext and the
+    // dispatcher read r14-r31, f14-f31, v14-v31, v64-v127, cr2-cr4, lr and
+    // msr by name, while generated code still touches ctx.lr / ctx.msr /
+    // ctx.fpscr / ctx.f1-f13 / ctx.v0-v13. A pruned struct would shift all of
+    // those offsets (e.g. lr 256 -> ~112) and silently corrupt guest state.
+    // The *_as_local options still take effect in codegen (registers become
+    // C++ locals); the fields simply stay reserved so the layout is identical
+    // on both sides. localize_fix_col.py also demotes live-in registers back
+    // to ctx.<reg>, which would not compile if the fields did not exist.
     PPCRegister r3;
-#ifndef PPC_CONFIG_NON_ARGUMENT_AS_LOCAL
     PPCRegister r0;
-#endif
     PPCRegister r1;
-#ifndef PPC_CONFIG_NON_ARGUMENT_AS_LOCAL
     PPCRegister r2;
-#endif
     PPCRegister r4;
     PPCRegister r5;
     PPCRegister r6;
@@ -318,12 +328,9 @@ struct alignas(0x40) PPCContext
     PPCRegister r8;
     PPCRegister r9;
     PPCRegister r10;
-#ifndef PPC_CONFIG_NON_ARGUMENT_AS_LOCAL
     PPCRegister r11;
     PPCRegister r12;
-#endif
     PPCRegister r13;
-#ifndef PPC_CONFIG_NON_VOLATILE_AS_LOCAL
     PPCRegister r14;
     PPCRegister r15;
     PPCRegister r16;
@@ -342,24 +349,12 @@ struct alignas(0x40) PPCContext
     PPCRegister r29;
     PPCRegister r30;
     PPCRegister r31;
-#endif
 
-#ifndef PPC_CONFIG_SKIP_LR
     uint64_t lr;
-#endif
-#ifndef PPC_CONFIG_CTR_AS_LOCAL
     PPCRegister ctr;
-#endif
-#ifndef PPC_CONFIG_XER_AS_LOCAL
     PPCXERRegister xer;
-#endif
-#ifndef PPC_CONFIG_RESERVED_AS_LOCAL
     PPCRegister reserved;
-#endif
-#ifndef PPC_CONFIG_SKIP_MSR
     uint32_t msr = 0x200A000;
-#endif
-#ifndef PPC_CONFIG_CR_AS_LOCAL
     PPCCRRegister cr0;
     PPCCRRegister cr1;
     PPCCRRegister cr2;
@@ -368,12 +363,16 @@ struct alignas(0x40) PPCContext
     PPCCRRegister cr5;
     PPCCRRegister cr6;
     PPCCRRegister cr7;
-#endif
     PPCFPSCRRegister fpscr;
 
-#ifndef PPC_CONFIG_NON_ARGUMENT_AS_LOCAL
+    // Fase 2: keep this layout byte-identical to the SDK's ::PPCContext
+    // (rex/ppc/context.h). The SDK has these two fields between fpscr and
+    // f0; without them every f*/v* register sits 8 bytes off across the
+    // guest/host boundary (hook marshalling, CRT fiber save/restore).
+    uint8_t vscr_sat = 0;
+    uint32_t last_indirect_target = 0;
+
     PPCRegister f0;
-#endif
     PPCRegister f1;
     PPCRegister f2;
     PPCRegister f3;
@@ -387,7 +386,6 @@ struct alignas(0x40) PPCContext
     PPCRegister f11;
     PPCRegister f12;
     PPCRegister f13;
-#ifndef PPC_CONFIG_NON_VOLATILE_AS_LOCAL
     PPCRegister f14;
     PPCRegister f15;
     PPCRegister f16;
@@ -406,7 +404,6 @@ struct alignas(0x40) PPCContext
     PPCRegister f29;
     PPCRegister f30;
     PPCRegister f31;
-#endif
 
     PPCVRegister v0;
     PPCVRegister v1;
@@ -422,7 +419,6 @@ struct alignas(0x40) PPCContext
     PPCVRegister v11;
     PPCVRegister v12;
     PPCVRegister v13;
-#ifndef PPC_CONFIG_NON_VOLATILE_AS_LOCAL
     PPCVRegister v14;
     PPCVRegister v15;
     PPCVRegister v16;
@@ -441,8 +437,6 @@ struct alignas(0x40) PPCContext
     PPCVRegister v29;
     PPCVRegister v30;
     PPCVRegister v31;
-#endif
-#ifndef PPC_CONFIG_NON_ARGUMENT_AS_LOCAL
     PPCVRegister v32;
     PPCVRegister v33;
     PPCVRegister v34;
@@ -475,8 +469,6 @@ struct alignas(0x40) PPCContext
     PPCVRegister v61;
     PPCVRegister v62;
     PPCVRegister v63;
-#endif
-#ifndef PPC_CONFIG_NON_VOLATILE_AS_LOCAL
     PPCVRegister v64;
     PPCVRegister v65;
     PPCVRegister v66;
@@ -541,7 +533,6 @@ struct alignas(0x40) PPCContext
     PPCVRegister v125;
     PPCVRegister v126;
     PPCVRegister v127;
-#endif
 };
 
